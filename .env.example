# GEMINI_API_KEY: Required for server-side Gemini Vision road damage detection.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YOLO_API_URL: Optional URL for the local Python FastAPI YOLO inference service.
# Example: http://127.0.0.1:8000/detect
YOLO_API_URL="http://127.0.0.1:8000/detect"
